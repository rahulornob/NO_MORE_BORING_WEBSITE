# ── Required for production ──────────────────────────────────────────────
# Password for /admin. Pick something long and random.
ADMIN_PASSWORD=

# Canonical URL of the deployed site (no trailing slash). Used for SEO,
# sitemaps and social cards.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Notion (primary content source) ──────────────────────────────────────
# Create an internal integration at https://www.notion.so/my-integrations,
# share your database with it, then paste the secret + database id here.
# Full walkthrough in README.md.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ── Google Sheets (optional, read-only alternative source) ───────────────
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_API_KEY=
# GOOGLE_SHEETS_RANGE=Sites

# ── Optional ─────────────────────────────────────────────────────────────
# Force a source instead of auto-detecting: notion | sheets | sample
# DATA_SOURCE=
